# ===================================================================
# ARUN-D'CHAT ENVIRONMENT CONFIGURATION
# ===================================================================

# AI Provider: 'google' (default) atau 'openai'
AI_PROVIDER=google

# 1. GOOGLE GEMINI CONFIGURATION (Vercel AI SDK @ai-sdk/google)
# Dapatkan API Key gratis di Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_gemini_api_key_here
AI_MODEL=gemini-1.5-pro
AI_FAST_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# 2. OPENAI CONFIGURATION (Vercel AI SDK @ai-sdk/openai) - Aktifkan jika AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# AI_MODEL=gpt-4o
# AI_FAST_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# 3. SUPABASE DATABASE & PGVECTOR CONFIGURATION
# Dapatkan di dashboard Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 4. APLIKASI
DEFAULT_USER_ID=user_default_01
RATE_LIMIT_REQUESTS_PER_MINUTE=30
NEXT_PUBLIC_AI_PROVIDER=Google Gemini (gemini-1.5-pro)
