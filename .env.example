# AI Provider: 'google' (default) atau 'openai'
AI_PROVIDER=google

# Google Gemini Configuration
# Dapatkan API Key di: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_google_gemini_api_key_here
AI_MODEL=gemini-3.5-flash-lite
AI_FAST_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=3072

# OpenAI Configuration (opsional jika AI_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key_here
# AI_MODEL=gpt-4o
# AI_FAST_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# Supabase Database & Vector (PostgreSQL + pgvector)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-backend-only

# Default User ID
DEFAULT_USER_ID=user_default_01

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=30
